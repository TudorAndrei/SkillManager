{
  "name": "skillmanager",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop front end for the skills CLI.",
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "npm run --prefix frontend build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "package": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "electron": "43.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
